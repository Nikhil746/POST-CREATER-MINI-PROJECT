<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Post Feed</title>
</head>
<body class="bg-gray-900 min-h-screen">
    <div class="max-w-xl mx-auto py-10 px-4">

        <h1 class="text-white text-xl font-semibold mb-4">Hello, <%= user.name %>!!!</h1>

        <form action="/posts/create" method="POST" class="bg-gray-800 rounded-lg p-4 mb-6">
            <textarea name="description" rows="3" placeholder="What's on your mind?"
                class="w-full px-3 py-2 bg-gray-700 text-white outline-none border border-gray-600 rounded-md focus:border-blue-500 resize-none"></textarea>
            <button type="submit"
                class="mt-3 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                Post
            </button>
        </form>

        <div class="flex flex-col gap-4">
            <% posts.forEach(post => { %>
                <div class="bg-gray-800 rounded-lg p-4 mb-2">
                    <p class="text-gray-300 text-sm font-semibold mb-2">@<%= user.username %></p>
                    <p class="text-white mb-2"><%= post.description %></p>
                    <p class="text-white mb-3">Likes <%=post.likes.length %> </p>

                    <div class="flex justify-between">
                       <div>
                           <form action="/posts/like/<%= post._id %>" method="POST">
                               <button type="submit"
                                   class="cursor-pointer px-3 py-1 text-sm rounded-md <%= post.liked ? 'bg-pink-600 text-white' : 'bg-gray-700 text-gray-300' %> hover:opacity-90">
                                   <%= post.likes.indexOf(user._id)!= -1  ? '♥ Liked' : '♡ Like' %>
                               </button>
                           </form>
                       </div>
                
                        <div>
                            <a href="/edit-post/<%=post._id %>" class="px-3 py-1 rounded-md text-sm text-gray-300 bg-gray-700">Edit</a>          
                            <a href="/post/remove/<%=post._id %>" class="px-3 py-1 rounded-md text-sm text-white bg-red-500">Remove</a>           
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

    </div>
</body>
</html>