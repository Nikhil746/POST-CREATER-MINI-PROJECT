<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Sign-Up user</title>
</head>

<body class="bg-gray-100">
    <div class="w-full min-h-screen flex items-center justify-center">
        <div class="bg-gray-800 p-8 rounded-lg shadow-lg w-full max-w-md">
            <h1 class="text-white text-xl font-semibold mb-6">Create User</h1>

            <form class="flex flex-col gap-4" action="/sign-up" method="POST">
                <div class="flex flex-col gap-1">
                    <label for="name" class="text-gray-300 text-sm">Name</label>
                    <input id="name" type="text" name="name" required
                        class="w-full px-3 py-2 bg-gray-700 text-white outline-none border border-gray-600 rounded-md focus:border-blue-500" />
                </div>

                <div class="flex flex-col gap-1">
                    <label for="email" class="text-gray-300 text-sm">Email</label>
                    <input id="email" type="email" name="email" required
                        class="w-full px-3 py-2 bg-gray-700 text-white outline-none border border-gray-600 rounded-md focus:border-blue-500" />
                </div>

                <div class="flex flex-col gap-1">
                    <label for="username" class="text-gray-300 text-sm">Username</label>
                    <input id="username" type="text" name="username" required
                        class="w-full px-3 py-2 bg-gray-700 text-white outline-none border border-gray-600 rounded-md focus:border-blue-500" />
                </div>

                <div class="flex flex-col gap-1">
                    <label for="password" class="text-gray-300 text-sm">Password</label>
                    <input id="password" type="password" name="password" required
                        class="w-full px-3 py-2 bg-gray-700 text-white outline-none border border-gray-600 rounded-md focus:border-blue-500" />
                </div>

                <button type="submit"
                    class="mt-2 w-full py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Sign up
                </button>
            </form>
        </div>
    </div>
</body>

</html>